# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://user:password@ep-pooler.neon.tech/dental_clinic_db?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-direct.neon.tech/dental_clinic_db?sslmode=require"

# JWT Auth
JWT_SECRET="replace_with_a_long_random_secret_string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="production"
LOG_LEVEL="info"

# Optional: Google Drive for document uploads
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""
